{
  "name": "george",
  "version": "0.6.1",
  "description": "Gr\u00f6bner bases, Hilbert series and Anick resolutions in the browser, an interface to bergman and more",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs web 8000",
    "examples": "node tools/make-examples.mjs",
    "ui:package": "node tools/package-ui.mjs",
    "test": "node --test --experimental-test-isolation=none test/*.test.mjs",
    "wasm:build": "ports/ecl/build.sh",
    "wasm:build:backends": "bash tools/build-backends.sh",
    "wasm:build:memory64": "bash tools/build-memory64-backend.sh",
    "wasm:test": "node tools/validate-wasm.mjs",
    "test:ocaml": "tools/validate-ocaml.sh && node tools/export-ocaml.mjs",
    "test:algebra": "node tools/validate-algebra.mjs",
    "test:backends": "node tools/validate-backends.mjs",
    "test:backends:browser": "node tools/validate-backends-browser.mjs",
    "test:backends:oracles": "node tools/validate-backend-oracles.mjs",
    "test:lhs:singular": "node tools/validate-lhs-singular.mjs",
    "test:fk": "node tools/validate-fomin-kirillov.mjs",
    "test:resolution:names": "node tools/validate-resolution-names.mjs",
    "test:braid": "node tools/validate-braid.mjs",
    "test:reader": "node tools/validate-reader.mjs",
    "test:upstream": "node tools/validate-upstream.mjs",
    "test:extra": "node tools/validate-extra.mjs",
    "test:examples": "node tools/validate-examples.mjs",
    "test:browser": "node tools/validate-browser.mjs",
    "test:ui": "node tools/validate-ui.mjs",
    "test:browser:regression": "node tools/validate-browser-uninstrumented.mjs",
    "sources": "bash tools/package-sources.sh",
    "sbcl:build": "ports/sbcl/build.sh vendor/bergman-1.001 build/sbcl-$(date +%Y%m%d-%H%M%S)",
    "sbcl:test": "ports/sbcl/runtests.sh $(ls -td build/sbcl-* | head -1) run-$(date +%Y%m%d-%H%M%S)",
    "sbcl:test:legacy": "ports/sbcl/runtests.sh $(ls -td build/sbcl-* | head -1) legacy-$(date +%Y%m%d-%H%M%S) legacy",
    "serve:native": "node tools/serve.mjs web 8000 --isolate",
    "test:native": "node tools/validate-fomkyr.mjs",
    "test:native:browser": "node tools/validate-fomkyr-browser.mjs",
    "test:static": "node tools/validate-static-isolation.mjs",
    "serve:fomkyr": "node tools/serve.mjs web 8000 --isolate",
    "test:fomkyr": "node tools/validate-fomkyr.mjs",
    "test:fomkyr:browser": "node tools/validate-fomkyr-browser.mjs",
    "wasm:build:fomkyr": "bash tools/build-fomkyr-backend.sh",
    "test:fomkyr:upgrade": "node tools/validate-fomkyr-upgrade.mjs",
    "test:fk6": "node tools/validate-fk6-matrix.mjs",
    "test:fk6:finite": "node tools/validate-fk6-matrix.mjs build/validation/fk6-finite --finite",
    "test:fk6:prefixes": "node tools/validate-fk6-degrees.mjs",
    "benchmark:resources": "node tools/benchmark-backend-resources.mjs --degrees 1,2,3,4,5,6,7,8,9 --configs fomkyr,fomkyr-firefox --skip-censored",
    "benchmark:fk6": "node tools/benchmark-fk6-suite.mjs"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "devDependencies": {
    "mathjax": "4.1.3",
    "playwright-core": "1.63.0"
  }
}
