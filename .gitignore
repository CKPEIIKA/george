# Kircracker's proof archive is a release asset (sha256 in kircracker/proof/CONTENTS.json);
# these data files are extracted or derived from it on first use.
/kircracker/proof/*.zip
/kircracker/data/base-through13.json
/kircracker/data/degree14-radical.json
/kircracker/data/star14-leading-words.json
