LIB "freegb.lib";
ring r=0,(b,a),Dp;
def A=freeAlgebra(r,15);
setring A;
ideal I=9*b*a*a*a-91*a*b*a*a+91*a*a*b*a-9*a*a*a*b,
9*b*b*b*a-91*b*b*a*b+91*b*a*b*b-9*a*b*b*b;
int started=timer;
ideal G=twostd(I);
print("COMPUTATION_TIMER_TICKS:"+string(timer-started));
print("RULES:"+string(size(G)));
for(int j=1;j<=size(G);j++){print("BASIS:"+string(G[j]));}
quit;
