LIB "freegb.lib";
ring r=0,(b,a,t),Dp;
def A=freeAlgebra(r,15);
setring A;
ideal I=16*b*a*a*a-84*a*b*a*a+84*a*a*b*a-16*a*a*a*b+225*t*t*b*a-225*t*t*a*b,
16*b*b*b*a-84*b*b*a*b+84*b*a*b*b-16*a*b*b*b+225*t*t*b*a-225*t*t*a*b,
a*t-t*a,
b*t-t*b;
int started=timer;
ideal G=twostd(I);
print("COMPUTATION_TIMER_TICKS:"+string(timer-started));
print("RULES:"+string(size(G)));
for(int j=1;j<=size(G);j++){print("BASIS:"+string(G[j]));}
quit;
