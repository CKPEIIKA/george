{
  "name": "fomkyr",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Exact homogeneous NC Groebner bases and Hilbert coefficients; adaptive shared/unshared WASM and bounded browser persistence",
  "scripts": {
    "build": "bash tools/build.sh",
    "test:wasm": "node --experimental-wasm-memory64 tests/test_wasm.mjs",
    "test:release": "node --experimental-wasm-memory64 tests/test_fomkyr.mjs",
    "test:integration": "node --experimental-wasm-memory64 tests/test_integration.mjs",
    "benchmark": "node --experimental-wasm-memory64 tests/benchmark_fomkyr.mjs 3 8",
    "test:compatibility": "node --experimental-wasm-memory64 tests/test_compatibility.mjs",
    "test:static-host": "node tests/test_static_host.mjs",
    "test:browsers": "python3 tests/test_browsers.py --browser all",
    "test:installer": "python3 tests/test_installer.py && python3 tests/test_installer_modern.py",
    "test:progress": "node tests/test_progress.mjs",
    "test:physics": "python3 tests/test_physics_matrix.py",
    "test:physics-wasm": "node --experimental-wasm-memory64 tests/test_physics_wasm.mjs",
    "test:optimizer": "python3 tests/test_optimizer_edges.py",
    "benchmark:speed": "python3 tests/benchmark_speed.py",
    "test:progress-integration": "node --experimental-wasm-memory64 tests/test_progress_integration.mjs",
    "test:all": "bash tools/verify_release.sh",
    "test:experimental": "bash tools/verify_experimental.sh",
    "benchmark:modular": "python3 tests/benchmark_modular.py",
    "test:rational": "python3 tests/test_rational_arithmetic.py && python3 tests/test_rational_cases.py",
    "test:direct": "bash tools/verify_direct.sh",
    "benchmark:direct": "python3 tests/benchmark_direct.py"
  }
}
