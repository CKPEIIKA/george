LIB "freegb.lib";
ring fk_r=0,(fk_var_14,fk_var_13,fk_var_12,fk_var_11,fk_var_10,fk_var_9,fk_var_8,fk_var_7,fk_var_6,fk_var_5,fk_var_4,fk_var_3,fk_var_2,fk_var_1,fk_var_0),Dp;
def fk_a=freeAlgebra(fk_r,2);
setring fk_a;
option(redSB);option(intStrategy);
ideal I=0;
ideal G=twostd(I);
for(int j=1;j<=size(G);j++){if(G[j]!=0){print("POLY:"+string(G[j]));}}
print("ORACLE_DONE");
quit;
