LIB "freegb.lib";
ring gn_r=0,(gn_var_1,gn_var_0),Dp;
def gn_a=freeAlgebra(gn_r,4);
setring gn_a;
ideal I=gn_var_1*gn_var_0*gn_var_1-gn_var_0*gn_var_1*gn_var_0;
ideal B=gn_var_1*gn_var_0*gn_var_1-gn_var_0*gn_var_1*gn_var_0;
ideal G=twostd(I);
ideal H=twostd(B);
print("ORACLE:"+string(size(reduce(B,G)))+":"+string(size(reduce(I,H))));
for(int j=1;j<=size(G);j++){print("LEAD:"+string(lead(G[j])));}
quit;
