        "x^4",
        "y^4",
        "z^4-10*z^2+9"
      ],
      "comm": false,
      "maxdeg": 8,
      "scope": "complete",
      "fields": [
        0,
        2,
        5
      ],
      "plural": {
        "vars": [
          "x",
          "y",
          "z"
        ],
        "d": [
          "-z",
          "2*x",
          "-2*y"
        ],
        "ideal": [
          "x^4",
          "y^4",
          "z^4-10*z^2+9"
        ]
      },
      "adaptation": "Expand the upstream N=3 product (z+3)(z+1)(z-1)(z-3); present U(sl2) by its three defining relations in the free algebra.",
      "expectedFields": [
        0
      ]
    },
