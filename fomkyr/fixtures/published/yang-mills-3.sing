LIB "freegb.lib";
ring r=0,(c,b,a),Dp;
def A=freeAlgebra(r,20);
setring A;
ideal I=c*c*a-2*c*a*c+b*b*a-2*b*a*b+a*c*c+a*b*b,
c*c*b-2*c*b*c+b*c*c+b*a*a-2*a*b*a+a*a*b,
c*b*b+c*a*a-2*b*c*b+b*b*c-2*a*c*a+a*a*c;
int started=timer;
ideal G=twostd(I);
print("COMPUTATION_TIMER_TICKS:"+string(timer-started));
print("RULES:"+string(size(G)));
for(int j=1;j<=size(G);j++){print("BASIS:"+string(G[j]));}
quit;
