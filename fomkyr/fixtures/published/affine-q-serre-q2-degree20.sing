LIB "freegb.lib";
ring r=0,(b,a),Dp;
def A=freeAlgebra(r,20);
setring A;
ideal I=4*b*a*a*a-21*a*b*a*a+21*a*a*b*a-4*a*a*a*b,
4*b*b*b*a-21*b*b*a*b+21*b*a*b*b-4*a*b*b*b;
int started=timer;
ideal G=twostd(I);
print("COMPUTATION_TIMER_TICKS:"+string(timer-started));
print("RULES:"+string(size(G)));
for(int j=1;j<=size(G);j++){print("BASIS:"+string(G[j]));}
quit;
