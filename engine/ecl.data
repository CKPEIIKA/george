	T
	NIL ) ))


  (COND ((NOT (MEMBER (MKBMPATHEXPAND "$bmexe/") LOADDIRECTORIES!*))
	 (SETQ LOADDIRECTORIES!*
	       (CONS (MKBMPATHEXPAND "$bmexe/") LOADDIRECTORIES!*))))
  (COND ((NOT (MEMBER (MKBMPATHEXPAND "$bmload/") LOADDIRECTORIES!*))
