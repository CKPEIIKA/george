(defun BANNER-OUTPUT ()
  (DECLARE (SPECIAL |*BMVersion*|))
  (LISP:PRINC (FORMAT NIL "Welcome to the BERGMAN system. (v. ~A)" |*BMVersion*|))
  (ON RAISE)
  (TERPRI)
  (ENVIRON0::ENVVARSSET)
)

(SETQ *PRINT-CIRCLE* T)

(eval-when (:COMPILE-TOPLEVEL :LOAD-TOPLEVEL :EXECUTE)
 (load "switches.lsp")
)

