  (REDAND2LISPPOL arg1)))

(DE REDOR2LISPFORM (arg1) (PROGN
  (COND (!*OBSOLETENAMESINFORM (TERPRI)
	 (PRIN2 "*** REDOR2LISPFORM is obsolete - use REDOR2LISPPOL instead.")
