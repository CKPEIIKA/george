(CL!-SPECIFIC
(DM BMI!> (rrg) (CONS '!> (CDR rrg))) )

(REDUCE!-SPECIFIC
(DM BMI!> (rrg) (CONS 'IGREATERP (CDR rrg))) )

%# BMI!+ (inum, inum) : inum ;
(PSL!-AVOIDING (CL!-AVOIDING
(DM BMI!+ (rrg) (CONS 'PLUS2 (CDR rrg))) ))

(PSL!-SPECIFIC (REDUCE!-AVOIDING
