(DEFUN |GLOBALa| (ll)
   (LISP:MAPC #'(LAMBDA (lst)
     (COND
      ((BOUNDP lst) (EVAL (LIST 'DEFVAR lst)))
      (T (EVAL (LIST 'DEFVAR lst 'NIL)))
     ))
   ll)
 (EVAL `(PROCLAIM '(SPECIAL ,@ll)) )
)

(DEFMACRO GLOBAL (ll)
 `(eval-when (:COMPILE-TOPLEVEL :LOAD-TOPLEVEL :EXECUTE) (|GLOBALa| ,ll))
)


(defmacro FLUID (ll) `(GLOBAL ,ll))

