	  (RDS (OPEN "specmode.sl" 'INPUT))
	  MAINLOOP
	  (COND ((EQ (SETQ I!nR!e!a!d (READ)) !$EOF!$)
		 (CLOSE (RDS NIL))
		 (RETURN T)))
	  (EVAL I!nR!e!a!d)
	  (GO MAINLOOP) )
    T
    NIL )


(ERRORSET
   '(PROG (I!nR!e!a!d)
	  (RDS (OPEN "specmacr.sl" 'INPUT))
	  MAINLOOP
	  (COND ((EQ (SETQ I!nR!e!a!d (READ)) !$EOF!$)
